+        bm = bms[o.name]
+        bm.to_mesh(o.data)
+        bm.free()
+        o.data.update()
+    pts = []
+    for x, z in edge_points(site):
+        e = on_edge(x, z, site)
+        pts.append({"x": round(x, 6), "z": round(z, 6), "y": round(interp(sides[e[0]], e[1]), 7)})
+    edge = {
+        "format": "caysonverse-falls-site-edge", "version": 2, "provisional": False,
+        "note": ("village ground heights on the waterfall site box, from the village source build (art/village/tools/"
+                 "falls_site.py, vrb2): the village's seam is the polyline through these points (it has a vertex at each of "
+                 "the falls ground's boundary vertices; the points between lie on it), pocket flatten applied."),
+        "site": site, "spacing": 1, "order": "CCW from the north-west corner", "points": pts,
