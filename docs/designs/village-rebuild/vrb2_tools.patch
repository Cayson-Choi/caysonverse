@@ -0,0 +1,265 @@
+"""B1 waterfall site box, cut in the village source (vrb2, 2026-11-16; design: docs/designs/waterfall/design.md §7.2 V4-V6).
+
+The falls are their own model (client/public/models/village/waterfall.glb) and own everything inside
+`layout.backdrop.waterfall.site` (x -140..-100, z -104..-58, game metres). parts_nature.backdrop() no longer builds the old
+cliff, rocks, ribbons, mist, foam or pool (V1-V3) and parts_fill plants no forest card in the box (V9). This module cuts the
+ground that is left, in the authoring scene, before the bake (so the bake never sees the old ground inside the box):
+
+  V5b  pocket flatten: the ground is first split on the rest pocket's lines (x -106..-95, z -90..-68) and the 2 m ramp's
+       lines, then every vertex there is lowered toward 0: y *= 1 - smooth(2, 0, distance to the pocket box).
+  V4/V6 the ground grid (ground_outer, LM_grass) and the backdrop terrain (backdrop_near) are split on the box's four lines
+       and every face inside it goes; the faces against the outline are split again at the falls ground's boundary vertex
+       lines (every metre, every 2 m on x -140..-128), so the outline has a vertex at each.
+  V5   the seam: the visible (top-most) ground's height 1 mm outside the outline at each of those points, rounded to
+       1/128 m, is the seam polyline; every outline vertex of a visible layer is snapped onto it (a layer hidden under
+       another stays). The polyline is written as art/village/work/waterfall_site_edge.json (172 points, 1 m, CCW from the
+       north-west corner), the file build_waterfall.py meshes the falls ground to.
+
+This is scripts/patch-village-falls-site.mjs (feat/falls-w6, which cut the shipped GLB in place) done on the source.
+Blender is (X, Y, Z) = (x, -z, y).
+"""
+import json
+import math
+import os
+
+import bmesh
+import bpy
+from mathutils import Vector
+from mathutils.bvhtree import BVHTree
+
+RAMP = 2.0
+EPS = 1e-5
+GROUND = ("ground_outer", "backdrop_near")
+
+
+def smooth(a, b, x):
+    t = max(0.0, min(1.0, (x - a) / (b - a)))
+    return t * t * (3 - 2 * t)
+
+
+def box_dist(x, z, b):
+    return math.hypot(max(b["minX"] - x, 0.0, x - b["maxX"]), max(b["minZ"] - z, 0.0, z - b["maxZ"]))
+
+
+def falls_axes(site):
+    xs = [x for x in range(int(site["minX"]), int(site["maxX"]) + 1) if x > -128 or x % 2 == 0]
+    zs = list(range(int(site["minZ"]), int(site["maxZ"]) + 1))
+    return xs, zs
+
+
+def edge_points(site):
+    b = site
+    pts = []
+
+    def run(x0, z0, x1, z1):
+        n = round(math.hypot(x1 - x0, z1 - z0))
+        for i in range(n):
+            pts.append((x0 + (x1 - x0) * i / n, z0 + (z1 - z0) * i / n))
+    run(b["minX"], b["minZ"], b["maxX"], b["minZ"])
+    run(b["maxX"], b["minZ"], b["maxX"], b["maxZ"])
+    run(b["maxX"], b["maxZ"], b["minX"], b["maxZ"])
+    run(b["minX"], b["maxZ"], b["minX"], b["minZ"])
+    return pts
+
+
+def on_edge(x, z, b, tol=1e-4):
+    if abs(z - b["minZ"]) < tol and b["minX"] - tol <= x <= b["maxX"] + tol:
+        return "n", x
+    if abs(z - b["maxZ"]) < tol and b["minX"] - tol <= x <= b["maxX"] + tol:
+        return "s", x
+    if abs(x - b["maxX"]) < tol and b["minZ"] - tol <= z <= b["maxZ"] + tol:
+        return "e", z
+    if abs(x - b["minX"]) < tol and b["minZ"] - tol <= z <= b["maxZ"] + tol:
+        return "w", z
+    return None
+
+
+def game(v):
+    """Blender vertex co (object = world: the builders' meshes have identity transforms) -> game (x, y, z)."""
+    return v.co.x, v.co.z, -v.co.y
+
+
+def bisect(bm, faces, axis, value):
+    """Split `faces` on the game line x = value (axis 0) or z = value (axis 2)."""
+    faces = [f for f in faces if f.is_valid]
+    if not faces:
+        return
+    if axis == 0:
+        co, no = Vector((value, 0, 0)), Vector((1, 0, 0))
+    else:
+        co, no = Vector((0, -value, 0)), Vector((0, 1, 0))
+    edges = {e for f in faces for e in f.edges}
+    verts = {v for f in faces for v in f.verts}
+    bmesh.ops.bisect_plane(bm, geom=list(faces) + list(edges) + list(verts), dist=1e-6, plane_co=co, plane_no=no)
+
+
+def faces_in(bm, x0, x1, z0, z1):
+    out = []
+    for f in bm.faces:
+        xs = [v.co.x for v in f.verts]
+        zs = [-v.co.y for v in f.verts]
+        if max(xs) > x0 + EPS and min(xs) < x1 - EPS and max(zs) > z0 + EPS and min(zs) < z1 - EPS:
+            out.append(f)
+    return out
+
+
+def pocket_flatten(bm, pocket):
+    lines = [(2, pocket["minZ"]), (2, pocket["minZ"] - 1), (2, pocket["minZ"] - RAMP), (2, pocket["maxZ"]),
+             (2, pocket["maxZ"] + 1), (2, pocket["maxZ"] + RAMP), (0, pocket["maxX"]), (0, pocket["maxX"] + 1),
+             (0, pocket["maxX"] + RAMP), (0, pocket["minX"]), (0, pocket["minX"] - 1), (0, pocket["minX"] - RAMP)]
+    area = (pocket["minX"] - RAMP, pocket["maxX"] + RAMP, pocket["minZ"] - RAMP, pocket["maxZ"] + RAMP)
+    for axis, v in lines:
+        bisect(bm, faces_in(bm, *area), axis, v)
+    n = 0
+    for vert in bm.verts:
+        x, y, z = game(vert)
+        if y > 3:
+            continue
+        k = smooth(RAMP, 0.0, box_dist(x, z, pocket))
+        if k > 0 and abs(y) > 1e-6:
+            vert.co.z = y * (1 - k)
+            n += 1
+    return n
+
+
+def box_cut(bm, site, xs, zs):
+    b = site
+    for axis, v in ((0, b["minX"]), (0, b["maxX"]), (2, b["minZ"]), (2, b["maxZ"])):
+        bisect(bm, faces_in(bm, b["minX"] - 20, b["maxX"] + 20, b["minZ"] - 20, b["maxZ"] + 20), axis, v)
+    inside = []
+    for f in bm.faces:
+        c = f.calc_center_median()
+        x, z = c.x, -c.y
+        if b["minX"] + EPS < x < b["maxX"] - EPS and b["minZ"] + EPS < z < b["maxZ"] - EPS:
+            inside.append(f)
+    bmesh.ops.delete(bm, geom=inside, context="FACES")
+    # the seam lines on the faces lying against the outline
+    def against(f, side):
+        on = [on_edge(v.co.x, -v.co.y, b) for v in f.verts]
+        return sum(1 for e in on if e and e[0] == side) >= 2
+    for side, axis, vals in (("n", 0, xs), ("s", 0, xs), ("e", 2, zs), ("w", 2, zs)):
+        for v in vals:
+            fs = [f for f in bm.faces if f.is_valid and against(f, side)]
+            bisect(bm, fs, axis, v)
+    return len(inside)
+
+
+def apply(layout, work_dir, log=print):
+    fall = layout["backdrop"]["waterfall"]
+    site, pocket = fall.get("site"), fall.get("pocket")
+    if not site:
+        return None
+    xs, zs = falls_axes(site)
+    objs = [bpy.data.objects[n] for n in GROUND if n in bpy.data.objects]
+    for o in objs:
+        assert o.matrix_world == o.matrix_world.Identity(4), o.name
+    report = {}
+    bms = {}
+    for o in objs:
+        bm = bmesh.new()
+        bm.from_mesh(o.data)
+        # triangulate round the box first, the way the glTF export splits a quad (its first diagonal, 0-2): the cut lines
+        # then cross the very triangles the shipped file had, so the seam heights are the ones waterfall.glb was built to
+        near = faces_in(bm, site["minX"] - 25, site["maxX"] + 25, site["minZ"] - 25, site["maxZ"] + 25)
+        bmesh.ops.triangulate(bm, faces=[f for f in near if len(f.verts) > 3], quad_method="FIXED", ngon_method="BEAUTY")
+        flat = pocket_flatten(bm, pocket) if pocket else 0
+        cut = box_cut(bm, site, xs, zs)
+        bms[o.name] = bm
+        report[o.name] = {"pocket_verts": flat, "faces_cut": cut}
+    # the seam: the top-most ground 1 mm outside the outline at the falls ground's boundary vertices
+    trees = []
+    for bm in bms.values():
+        bm.verts.ensure_lookup_table()
+        bm.faces.ensure_lookup_table()
+        trees.append(BVHTree.FromBMesh(bm))
+    NUDGE = 1e-3
+
+    def top(x, z):
+        best = None
+        for t in trees:
+            hit = t.ray_cast(Vector((x, -z, 500.0)), Vector((0, 0, -1)))
+            if hit[0] is not None and (best is None or hit[0].z > best):
+                best = hit[0].z
+        return best
+
+    def nudge_x(x):
+        return -NUDGE if x <= site["minX"] + EPS else NUDGE if x >= site["maxX"] - EPS else 0.0
+
+    def nudge_z(z):
+        return -NUDGE if z <= site["minZ"] + EPS else NUDGE if z >= site["maxZ"] - EPS else 0.0
+    q128 = lambda y: round(y * 128) / 128  # noqa: E731
+    sides = {"n": [], "s": [], "e": [], "w": []}
+    for x in xs:
+        sides["n"].append((x, q128(top(x + nudge_x(x), site["minZ"] - NUDGE))))
+        sides["s"].append((x, q128(top(x + nudge_x(x), site["maxZ"] + NUDGE))))
+    for z in zs:
+        sides["w"].append((z, q128(top(site["minX"] - NUDGE, z + nudge_z(z)))))
+        sides["e"].append((z, q128(top(site["maxX"] + NUDGE, z + nudge_z(z)))))
+
+    # the seam contract: waterfall.glb's ground was meshed to the repo's docs/designs/waterfall/waterfall_site_edge.json
+    # (read from the shipped GLB, whose Draco grid rounded the backdrop to 34 mm). When it is there its heights are the
+    # seam (the cut ground's measured heights differ by a few cm), so the falls model fits without a rebuild.
+    ref_path = os.path.join(os.path.dirname(os.path.dirname(os.path.dirname(work_dir))), "docs", "designs", "waterfall",
+                            "waterfall_site_edge.json")
+    ref_dev = None
+    if os.path.exists(ref_path):
+        ref = {(round(p["x"], 4), round(p["z"], 4)): p["y"] for p in json.load(open(ref_path))["points"]}
+        corners = {"n": lambda t: (t, site["minZ"]), "s": lambda t: (t, site["maxZ"]), "e": lambda t: (site["maxX"], t),
+                   "w": lambda t: (site["minX"], t)}
+        ref_dev = 0.0
+        for k, tab in sides.items():
+            for i, (t, y) in enumerate(tab):
+                key = tuple(round(v, 4) for v in corners[k](t))
+                if key in ref:
+                    ref_dev = max(ref_dev, abs(ref[key] - y))
+                    tab[i] = (t, ref[key])
+
+    def interp(tab, t):
+        if t <= tab[0][0]:
+            return tab[0][1]
+        for (t0, y0), (t1, y1) in zip(tab[:-1], tab[1:]):
+            if t <= t1:
+                return y0 + (y1 - y0) * (t - t0) / ((t1 - t0) or 1)
+        return tab[-1][1]
+    snapped, worst, worst_at = 0, 0.0, None
+    for name, bm in bms.items():
+        for v in bm.verts:
+            x, y, z = game(v)
+            e = on_edge(x, z, site)
+            if not e:
+                continue
+            t_top = top(x + nudge_x(x), z + nudge_z(z))
+            if t_top is None or y < t_top - 0.1:
+                continue        # a layer hidden under another stays
+            t = round(e[1] * 128) / 128
+            yy = round(interp(sides[e[0]], t) * 128) / 128
+            if abs(y - yy) > worst:
+                worst, worst_at = abs(y - yy), (name, round(x, 3), round(z, 3), round(y, 3), yy)
+            if e[0] in ("n", "s"):
