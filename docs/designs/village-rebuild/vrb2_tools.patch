+"""Re-fit the fountain crescent's DAY probe for a sun-split light map (vrb2, 2026-11-16; sun-shadows design §4 step 4).
+
+  blender -b art/village/work/village_lmprep.blend -P art/village/tools/fit_moon_probe_split.py -- [--samples 256] [--size 512]
+
+fit_moon_probe.py fits the probe to a GLB whose crescent was light-mapped; since fix/fix-moon-smooth the bake leaves the
+crescent out of the light map, so there is no such GLB for a new bake. This bakes the crescent alone, in the saved light-map
+scene (village_lmprep.blend: the same sun, sky and surroundings as the day bake), on its own UV: the full day light and the
+sun lamp's direct light, as bake_village.py does for the map (SUN_SPLIT), then fits SH9 over the normal (game axes, the
+same basis and robust ridge fit as fit_moon_probe.py) to
+  with_sun = (L + lift) / LM_SCALE           (checks the method against the shipped MOON_PROBE.day)
+  sun_free = (L - L_sun + lift) / LM_SCALE   (the new MOON_PROBE.day; sunShadows.ts MOON_PROBE_HAS_SUN = false)
+The night probe does not change (the night bake is the same). Prints both arrays.
+"""
+import json
+import os
+import sys
+
+import bpy
+import numpy as np
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import bake_village as BV  # noqa: E402
+
+
+def sh9(n):
+    """fit_moon_probe.py's basis (that module needs PIL, which Blender's Python lacks)."""
+    x, y, z = n[:, 0], n[:, 1], n[:, 2]
+    return np.stack([np.ones_like(x), y, z, x, x * y, y * z, 3 * z * z - 1, x * z, x * x - y * y], axis=1)
+
+
+def fit(F, Y, c, lam=5.0, it=10):
+    """fit_moon_probe.py's robust ridge least squares."""
+    R = np.diag([0, 0, 0, 0] + [lam] * 5)
+    w = np.ones(len(F))
