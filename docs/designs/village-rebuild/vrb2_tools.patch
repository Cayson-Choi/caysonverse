diff -ruN -x __pycache__ a/art/village/tools/reexport_village.py tools/reexport_village.py
--- a/art/village/tools/reexport_village.py	1970-01-01 09:00:00.000000000 +0900
+++ b/art/village/tools/reexport_village.py	2026-11-16 23:08:39.667725400 +0900
@@ -0,0 +1,30 @@
+"""Export village.glb again from the saved work/village_export.blend, exactly as bake_village.main's export (vrb2).
+
+  blender -b art/village/work/village_export.blend -P art/village/tools/reexport_village.py -- [--out <glb>]
+
+For an export setting change without a re-bake (the light maps stay valid: the same UV_LM). bake_village.EXPORT_KW holds
+the settings, so the two never drift.
+"""
+import os
+import sys
+
+import bpy
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import bake_village as BV  # noqa: E402
+
+argv = sys.argv[sys.argv.index("--") + 1:] if "--" in sys.argv else []
+out = argv[argv.index("--out") + 1] if "--out" in argv else os.path.join(BV.EXPORT, "village.glb")
+objs = bpy.data.objects
+exported = sorted([o for o in objs if o.type == "MESH" and o.name.startswith("village_") and o.get("cat") not in ("collider", "moon", "occluder")],
+                  key=lambda o: o.name)
+inst = [o for o in objs if o.get("cat") in ("inst", "inst_root")]
+cols = [o for o in objs if o.get("cat") == "collider"]
+lights = [o for o in objs if o.get("cat") in ("light", "seat")]
+BV.select(exported + inst + cols + lights, exported[0])
+bpy.ops.export_scene.gltf(filepath=out, **BV.EXPORT_KW)
+seat_props = {o.name: {k: (round(float(o[k]), 3) if isinstance(o[k], float) else o[k]) for k in o.keys()
+                       if k != "cat" and isinstance(o[k], (int, float, str, bool))}
+              for o in objs if o.get("cat") == "seat"}
+BV.patch_glb(out, seat_props)
+print("REEXPORTED", out, os.path.getsize(out), len(exported), "meshes")
