+def sun_only(scene, size, samples):
+    """--sunonly (on work/village_lmprep.blend): bake the sun's direct light alone into work/village_lm_sun.png and
+    write work/village_lm_sunfree.png = the shipped day map (work/village_lm.png) minus it, on the same UV_LM. Lets the
+    CURRENT day map be split without a full re-bake (and checks the split); nothing is exported."""
+    lms = [o for o in bpy.data.objects if o.type == "MESH" and o.get("cat") == "lm" and len(o.data.polygons)]
+    sun = bake_sun_direct(scene, lms, size, samples)
+    save_png(encode_lm(sun), os.path.join(WORK, "village_lm_sun.png"))
+    np.save(os.path.join(WORK, "village_lm_sun.npy"), sun.astype(np.float16))
+    day_png = os.path.join(WORK, "village_lm.png")
+    if os.path.exists(day_png):
+        day = decode_lm(load_png(day_png))
