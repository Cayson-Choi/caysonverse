+def encode_lm(b):
+    """Light (L units) -> the light map's encoding: L / LM_SCALE, clipped to 1, sRGB."""
+    enc = np.clip(b / LM_SCALE, 0, 1)
+    return np.where(enc <= 0.0031308, enc * 12.92, 1.055 * np.power(enc, 1 / 2.4) - 0.055)
+
+
+def decode_lm(enc):
+    """encode_lm's inverse (a clipped texel stays clipped)."""
+    return np.where(enc <= 0.04045, enc / 12.92, np.power((enc + 0.055) / 1.055, 2.4)) * LM_SCALE
+
